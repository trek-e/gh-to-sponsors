{
  "name": "gh-to-sponsors",
  "version": "0.1.0",
  "description": "A syndication tool for open source creators to post GitHub activity updates to supporter platforms",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "generate-digest": "node --import tsx src/actions/generate-digest.ts",
    "process-approval": "node --import tsx src/actions/process-approval.ts"
  },
  "keywords": [
    "github",
    "patreon",
    "ghost",
    "syndication",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-ses": "^3.980.0",
    "@octokit/rest": "^22.0.1",
    "@sendgrid/mail": "^8.1.6",
    "resend": "^4.0.1",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
